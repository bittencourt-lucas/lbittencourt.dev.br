---
interface Props {
  variant?: "primary" | "ghost" | "link";
  size?: "sm" | "md" | "lg";
  href?: string;
  target?: string;
  rel?: string;
  type?: "button" | "submit" | "reset";
  disabled?: boolean;
  class?: string;
  "aria-label"?: string;
}

const {
  variant = "primary",
  size = "md",
  href,
  target,
  rel,
  type = "button",
  disabled = false,
  class: className = "",
  "aria-label": ariaLabel,
} = Astro.props;

const isAnchor = !!href;
const Tag = isAnchor ? "a" : "button";

const base =
  "inline-flex items-center justify-center gap-2 font-mono text-sm tracking-wide transition-all duration-150 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent";

const variantClasses = {
  primary: "bg-accent text-bg hover:bg-accent-hover active:scale-[0.98]",
  ghost:
    "border border-border text-fg hover:border-accent hover:text-accent active:scale-[0.98]",
  link: "text-accent underline-offset-4 hover:underline",
};

const sizeClasses = {
  sm: "px-4 py-2 text-xs",
  md: "px-6 py-3",
  lg: "px-8 py-4 text-base",
};

const padding = variant === "link" ? "" : sizeClasses[size];
const disabledClasses = disabled ? "opacity-40 pointer-events-none" : "";

const resolvedRel =
  isAnchor ? (rel ?? (target === "_blank" ? "noopener noreferrer" : undefined)) : undefined;
---

<Tag
  href={isAnchor ? href : undefined}
  target={isAnchor ? target : undefined}
  rel={resolvedRel}
  type={!isAnchor ? type : undefined}
  disabled={!isAnchor ? disabled : undefined}
  aria-label={ariaLabel}
  class:list={[base, variantClasses[variant], padding, disabledClasses, className]}
>
  <slot />
</Tag>
