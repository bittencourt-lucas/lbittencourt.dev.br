---
interface Props {
  level?: 1 | 2 | 3 | 4 | 5 | 6;
  size?: "display" | "xl" | "lg" | "md" | "sm" | "xs";
  class?: string;
}

const { level = 2, size, class: className = "" } = Astro.props;

const sizeMap = {
  display: "text-display font-bold tracking-tight leading-none",
  xl: "text-4xl md:text-5xl font-bold tracking-tight leading-tight",
  lg: "text-3xl md:text-4xl font-bold tracking-tight leading-tight",
  md: "text-2xl md:text-3xl font-semibold tracking-tight leading-snug",
  sm: "text-xl md:text-2xl font-semibold leading-snug",
  xs: "text-lg font-semibold leading-snug",
} as const;

const defaultSizeMap: Record<number, keyof typeof sizeMap> = {
  1: "display",
  2: "xl",
  3: "lg",
  4: "md",
  5: "sm",
  6: "xs",
};

const resolvedSize = size ?? defaultSizeMap[level];
const Tag = `h${level}` as "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
---

<Tag class:list={[sizeMap[resolvedSize], className]}>
  <slot />
</Tag>
