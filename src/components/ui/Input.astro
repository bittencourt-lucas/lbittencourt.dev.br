---
type InputType =
  | "button" | "checkbox" | "color" | "date" | "datetime-local"
  | "email" | "file" | "hidden" | "image" | "month" | "number"
  | "password" | "radio" | "range" | "reset" | "search" | "submit"
  | "tel" | "text" | "time" | "url" | "week";

interface Props {
  name: string;
  label?: string;
  type?: InputType;
  placeholder?: string;
  required?: boolean;
  autocomplete?: string;
  error?: string;
  class?: string;
}

const {
  name,
  label,
  type = "text",
  placeholder,
  required = false,
  autocomplete,
  error,
  class: className = "",
} = Astro.props;
---

<div class:list={["flex flex-col gap-1.5", className]}>
  {
    label && (
      <label for={name} class="font-mono text-xs tracking-widest uppercase text-fg-muted">
        {label}
        {required && <span class="text-accent ml-1" aria-hidden="true">*</span>}
      </label>
    )
  }
  <input
    id={name}
    name={name}
    type={type}
    placeholder={placeholder}
    required={required}
    autocomplete={autocomplete}
    aria-invalid={error ? "true" : undefined}
    aria-describedby={error ? `${name}-error` : undefined}
    class:list={[
      "w-full bg-bg border text-fg font-sans text-sm px-4 py-3",
      "placeholder:text-fg-muted/50",
      "focus:outline-none focus:border-accent",
      "transition-colors duration-150",
      error ? "border-red-500" : "border-border",
    ]}
  />
  {
    error && (
      <p id={`${name}-error`} class="font-mono text-xs text-red-500" role="alert">
        {error}
      </p>
    )
  }
</div>
